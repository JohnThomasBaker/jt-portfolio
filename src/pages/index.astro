---
import BaseLayout from "../layouts/BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";
import { pieces } from "../data/music";
import { posts } from "../data/news";

const instagramProfileUrl = "https://www.instagram.com/jt_baker_/";
const instagramReelIds = [
  "DZRGUrNAVMz",
  "DRkX1UhAJ_A",
  "DQnTXYxgKzP",
  "DMEn79-AkjG",
  "C2YG0DsuTD8",
  "CiP8gLpO1dR",
  "DRs-_PxAAVb",
  "DYy07E5BGY0",
  "DbstTxSBt9C",
];
const tiktokProfileUrl = "https://www.tiktok.com/@jtmusicks";
---

<BaseLayout title="JT Baker | Composer and Percussionist" description="Music, scores, projects, and news from composer and percussionist JT Baker." mainClass="page-home">
  <!-- HERO (full width) -->
  <FadeIn blur={60} y={0} duration={1200} bg="#C0C2D1">
    <section class="hero">
      <div class="hero-content">
        <div class="hero-title-row">
          <h1 class="hero-main-heading" style="color: #B8860B !important;">Welcome</h1>
          <p class="hero-subtitle">JT's Music</p>
        </div>
      </div>
    </section>
  </FadeIn>
  <!-- ABOUT -->
  <FadeIn>
    <section class="wrap about-wrap">
      <div class="card about">
        <button class="avatar-stack" type="button" aria-label="Show next portrait of JT">
          <img class="avatar" data-position="0" src="/images/avatar.jpg" alt="JT portrait" />
          <img class="avatar" data-position="1" src="/images/Avatar2.jpg" alt="" />
          <img class="avatar" data-position="2" src="/images/stick%20in%20mouth.JPG" alt="JT with a drumstick in his mouth" loading="lazy" />
        </button>
        <div class="about-copy">
          <h2 class="section-title st-red">About JT</h2>
          <p class="muted about-role">
            Composer, percussionist, snare drummer
          </p>
          <p style="margin-bottom: 0;">
            How's it going. I'm JT. I'm a percussionist turned composer currently working in Toledo, Ohio. I primarily write percussion and chamber works, often toeing the line between the classical and marching percussion worlds and contemporary experimental music. This practice is shared by a lifelong passion for rudimental snare drumming and the marching arts, where I've spent time as a performer, writer, and teacher.

Here you can access my work, buy music, and get in contact with me. Thanks for coming.
          </p>
          <figure class="about-scrapbook">
            <img
              class="about-signature"
              src="/images/JT%20signature%20with%20Drum.png"
              alt="JT signature with a drum"
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </section>
  </FadeIn>

  <!-- FEATURED -->
  <FadeIn delay={120}>
    <section class="wrap featured-wrap">
      <div class="card media-stack">
        <div class="media-stack-head">
          <h2 class="section-title st-navy">Check This Stuff Out</h2>
        </div>

        <div class="media-pyramid">
          <article class="media-scroll media-scroll-social media-scroll-instagram">
            <h3 class="media-title-instagram">Instagram</h3>
            <iframe
              data-random-instagram-reel
              data-reel-ids={JSON.stringify(instagramReelIds)}
              src={`https://www.instagram.com/reel/${instagramReelIds[0]}/embed/`}
              title="Featured Instagram reel by @jt_baker_"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <a href={instagramProfileUrl} target="_blank" rel="noopener noreferrer">@jt_baker_</a>
          </article>

          <article class="media-scroll media-scroll-social media-scroll-tiktok">
            <h3 class="media-title-tiktok">TikTok</h3>
            <iframe
              src="https://www.tiktok.com/player/v1/7669427958070758670?autoplay=0&controls=1&description=1"
              title="Featured TikTok video by @jtmusicks"
              allow="fullscreen"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <a href={tiktokProfileUrl} target="_blank" rel="noopener noreferrer">@jtmusicks</a>
          </article>
        </div>
      </div>
    </section>
  </FadeIn>

  <!-- MUSIC GRID -->
  <FadeIn delay={240} y={18}>
    <section class="wrap">
      <h2 class="section-title st-red" style="margin-bottom: 0.75rem;">Featured Projects</h2>

      <div class="music-grid">
        {pieces.slice(0, 4).map((piece) => (
          <a class="card card-link" href={`/music/${piece.slug}`}>
            <div class="thumb"></div>
            <div class="card-body">
              <h3 class="card-title">{piece.name}</h3>
              <p class="muted">{piece.instrumentation} · {piece.year}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </FadeIn>

  <!-- NEWS -->
  <FadeIn delay={360} y={18}>
    <section class="wrap home-news-section">
      <h2 class="section-title" style="margin-bottom: 0.75rem;">JT News</h2>

      <div class="news">
        {posts.slice(0, 1).map((post) => (
          <a class="card card-link news-item" href={`/news/${post.slug}`}>
            <div>
              <h3 class="card-title">{post.title}</h3>
              <p class="muted" style="margin: 0.25rem 0 0;">{post.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </FadeIn>
</BaseLayout>

<script is:inline>
  const initPortraitStack = () => {
    window.__jtPortraitCleanup?.();
    const stack = document.querySelector(".avatar-stack");
    if (!stack) return;
    const photos = Array.from(stack.querySelectorAll(".avatar"));
    let front = 0;
    let pending = 0;
    let busy = false;
    let disposed = false;
    let wipe = null;
    let animation = null;
    const advance = () => {
      if (disposed || busy || !pending) return;
      pending--;
      const outgoing = photos[front];
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reducedMotion) {
        // Keep the outgoing photo above the layer change, then reveal the next one.
        wipe = outgoing.cloneNode(false);
        wipe.className = "portrait-wipe";
        wipe.removeAttribute("data-position");
        wipe.alt = "";
        wipe.setAttribute("aria-hidden", "true");
        const style = getComputedStyle(outgoing);
        Object.assign(wipe.style, {
          position: "absolute", left: "0", top: "0", zIndex: "5",
          width: style.width, height: style.height,
          objectFit: style.objectFit, objectPosition: style.objectPosition,
          pointerEvents: "none", display: "block",
        });
        stack.append(wipe);
      }
      front = (front + 1) % photos.length;
      photos.forEach((photo, index) => {
        photo.dataset.position = String((index - front + photos.length) % photos.length);
      });
      if (reducedMotion) { advance(); return; }
      busy = true;
      animation = wipe.animate([
        { clipPath: "inset(0 0 0 0)" },
        { clipPath: "inset(0 0 0 100%)" },
      ], { duration: 120, easing: "cubic-bezier(.4,0,.2,1)", fill: "forwards" });
      animation.onfinish = () => {
        wipe?.remove();
        wipe = null;
        animation = null;
        busy = false;
        advance();
      };
    };
    const next = () => { pending++; advance(); };
    stack.addEventListener("mouseenter", next);
    stack.addEventListener("mouseleave", next);
    stack.addEventListener("click", next);
    window.__jtPortraitCleanup = () => {
      disposed = true;
      animation?.cancel();
      wipe?.remove();
      stack.removeEventListener("mouseenter", next);
      stack.removeEventListener("mouseleave", next);
      stack.removeEventListener("click", next);
    };
  };
  document.addEventListener("astro:page-load", initPortraitStack);
  document.addEventListener("DOMContentLoaded", initPortraitStack);
  document.addEventListener("astro:before-swap", () => window.__jtPortraitCleanup?.());

  const initRandomInstagramReel = () => {
    const frame = document.querySelector("[data-random-instagram-reel]");
    if (!frame) return;

    const reelIds = JSON.parse(frame.dataset.reelIds || "[]");
    if (!reelIds.length) return;

    const reelId = reelIds[Math.floor(Math.random() * reelIds.length)];
    frame.src = `https://www.instagram.com/reel/${reelId}/embed/`;
  };

  document.addEventListener("DOMContentLoaded", initRandomInstagramReel);
  document.addEventListener("astro:page-load", initRandomInstagramReel);

  const initSocialStackCycle = () => {
    const stack = document.querySelector("[data-social-stack]");
    if (!stack) return;

    const cards = Array.from(stack.querySelectorAll("[data-social-card]"));
    if (cards.length !== 3) return;
    const prevButton = stack.querySelector("[data-social-prev]");
    const nextButton = stack.querySelector("[data-social-next]");

    window.__jtSocialStackCleanup?.();

    let frontIndex = 0;
    let interval = null;

    const updatePositions = () => {
      cards.forEach((card, index) => {
        const offset = (index - frontIndex + cards.length) % cards.length;
        card.classList.remove("is-front", "is-back-left", "is-back-right");
        if (offset === 0) card.classList.add("is-front");
        if (offset === 1) card.classList.add("is-back-right");
        if (offset === 2) card.classList.add("is-back-left");
      });
    };

    const restartInterval = () => {
      if (interval) window.clearInterval(interval);
      interval = window.setInterval(() => {
        frontIndex = (frontIndex + 1) % cards.length;
        updatePositions();
      }, 10000);
    };

    const goNext = () => {
      frontIndex = (frontIndex + 1) % cards.length;
      updatePositions();
      restartInterval();
    };

    const goPrev = () => {
      frontIndex = (frontIndex - 1 + cards.length) % cards.length;
      updatePositions();
      restartInterval();
    };

    prevButton?.addEventListener("click", goPrev);
    nextButton?.addEventListener("click", goNext);
    updatePositions();
    restartInterval();

    window.__jtSocialStackCleanup = () => {
      if (interval) window.clearInterval(interval);
      prevButton?.removeEventListener("click", goPrev);
      nextButton?.removeEventListener("click", goNext);
    };
  };

  initSocialStackCycle();
  document.addEventListener("DOMContentLoaded", initSocialStackCycle);
  document.addEventListener("astro:page-load", initSocialStackCycle);
</script>

<style>
  .about-wrap {
    padding-bottom: 10px;
  }

  .about-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 136px;
    column-gap: 10px;
    align-items: start;
  }

  .about-copy > h2,
  .about-copy > .about-role {
    grid-column: 1 / -1;
  }

  .about-scrapbook {
    align-self: end;
    width: 136px;
    margin: 0 0 -38px 0;
    /* Tuck the signature just beneath the end of the biography. */
    transform: translate(-136px, 34px);
  }

  .about-signature {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) sepia(0.2) saturate(0.9) brightness(0.65);
  }

  @media (max-width: 900px) {
    .about-copy { grid-template-columns: minmax(0, 1fr); }
    .about-scrapbook {
      justify-self: end;
      width: 136px;
      margin: 0 -6px -42px 0;
      transform: translate(-144px, 40px);
    }
  }

  .hero {
    overflow: visible;
  }

  .hero-content {
    padding-top: 0;
    padding-bottom: 0;
    justify-content: center;
  }

  .hero-lately-wrap {
    position: absolute;
    right: clamp(24px, 7vw, 110px);
    top: 100%;
    transform: translateY(-50%);
    z-index: 4;
    width: min(320px, 34vw);
  }

  .hero-audio-card {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    background: rgba(239, 241, 245, 0.3);
    border: 1px solid rgba(61, 69, 86, 0.2);
    box-shadow: 0 9px 22px rgba(34, 39, 53, 0.12);
    backdrop-filter: blur(30px) saturate(1.15);
    box-sizing: border-box;
    overflow: hidden;
    min-height: 4.9rem;
  }

  .hero-audio-play {
    align-self: center;
    transform: none;
    flex: 0 0 auto;
    width: 2.82rem;
    height: 2.82rem;
    display: grid;
    place-items: center;
    padding-left: 0.18rem;
    background: transparent;
    border: 1px solid #fff;
    border-radius: 50%;
    color: #fff !important;
    -webkit-text-fill-color: #fff;
    font-size: 0.72rem;
    box-shadow: 0 2px 8px rgba(20, 23, 33, 0.5);
  }

  .hero-audio-copy {
    min-width: 0;
    flex: 1;
    align-self: stretch;
    position: relative;
    display: flex;
    align-items: center;
  }

  .hero-audio-meta {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.75rem;
    position: absolute;
    top: -0.8rem;
    left: 0;
    right: 0;
  }

  .hero-audio-meta p {
    margin: 0;
    transform: translateX(-1.55rem);
    color: #fff !important;
    -webkit-text-fill-color: #fff;
    font-family: "Jacquard24", serif;
    font-size: 1.414rem;
    letter-spacing: 0.12em;
    text-shadow: 0 2px 6px rgba(20, 23, 33, 0.7);
  }

  .hero-audio-meta span {
    position: absolute;
    right: 0;
    color: #fff !important;
    -webkit-text-fill-color: #fff;
    font-size: 0.72rem;
    text-shadow: 0 2px 6px rgba(20, 23, 33, 0.7);
  }

  .hero-audio-copy strong {
    display: block;
    margin: 0.08rem 0 0.25rem;
    color: #fff !important;
    -webkit-text-fill-color: #fff;
    font-family: "JTDisplay", system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 400;
    text-shadow: 0 2px 7px rgba(20, 23, 33, 0.75);
  }

  .hero-audio-waveform {
    align-self: center;
    height: 1.45rem;
    margin-left: -0.75rem;
    width: calc(100% + 0.75rem);
  }

  .hero-audio-waveform svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: none !important;
    box-shadow: none !important;
  }

  .hero-audio-waveform path {
    fill: none;
    stroke: #fff !important;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: none !important;
    box-shadow: none !important;
  }


  .featured-wrap {
    padding-top: 10px;
  }

  .home-news-section {
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    background: var(--nav-reveal-bg) !important;
  }

  .media-stack {
    padding-top: 1.1rem;
  }

  .about-role {
    margin: -0.22rem 0 0.3rem !important;
    font-size: clamp(1.56rem, 1.98vw, 2.04rem) !important;
    line-height: 0.98 !important;
    font-family: "JTDisplay", system-ui, sans-serif;
  }

  .about .section-title.st-red {
    margin-bottom: 0 !important;
  }

  .media-stack-head {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 0 0 0.2rem auto;
    width: min(100%, 760px);
  }

  .media-stack-head h2 {
    margin: 0;
    white-space: nowrap;
  }

  .media-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    justify-self: end;
    margin-right: 14px;
    color: var(--tone-slate) !important;
    text-decoration: none;
    font-family: "Times New Roman", Times, serif;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .media-all-link:hover {
    color: var(--tone-slate) !important;
    text-decoration: underline;
  }

  .media-all-arrow {
    width: 1.45rem;
    height: 1.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    line-height: 1;
    color: var(--tone-slate) !important;
  }

  .media-pyramid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1.25rem;
    width: min(100%, 760px);
    margin: 0.5rem 0 0 auto;
  }

  .media-rotate {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid rgba(75, 91, 118, 0.45);
    background: var(--nav-reveal-bg);
    color: var(--tone-slate);
    font-family: "JTDisplay", system-ui, sans-serif;
    font-size: 1.5rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    cursor: pointer;
  }

  .media-rotate:hover {
    background: rgba(154, 165, 192, 0.88);
  }

  .media-rotate-prev {
    left: -4.4rem;
  }

  .media-rotate-next {
    right: -4.4rem;
  }

  .media-scroll {
    min-width: 0;
    padding: 1rem;
    border: 1px solid rgba(63, 70, 94, 0.2);
    background: rgba(255, 255, 255, 0.38);
  }

  .media-scroll h3 {
    margin: 0 0 0.45rem;
    font-family: "Jacquard24", serif;
    font-size: clamp(2rem, 3.2vw, 3rem);
    color: var(--tone-heading);
    text-align: center;
  }

  .media-scroll h3.media-title-youtube {
    color: var(--tone-slate) !important;
  }

  .media-scroll h3.media-title-instagram {
    color: var(--tone-plum) !important;
  }

  .media-scroll h3.media-title-tiktok {
    color: var(--tone-teal) !important;
  }

  .media-scroll-youtube {
    width: 100%;
  }

  .media-scroll-youtube .video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(75, 91, 118, 0.12);
  }

  .media-scroll-youtube .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media-scroll-social iframe {
    display: block;
    width: min(100%, 326px);
    height: 560px;
    margin-inline: auto;
    border: 0;
    background: #fff;
  }

  .media-scroll-tiktok iframe {
    display: block;
    width: min(100%, 315px);
    height: 560px;
    margin-inline: auto;
    border-radius: 8px;
    background: #000;
  }

  .media-scroll a {
    margin-top: 0.45rem;
    display: block;
    text-align: center;
    font-family: "JTDisplay", system-ui, sans-serif;
    font-size: 1.05rem;
    color: var(--tone-plum);
    text-decoration: none;
  }

  .media-scroll a:hover {
    text-decoration: underline;
  }

  .media-scroll.is-front {
    transform: none;
  }

  .media-scroll.is-back-left {
    transform: none;
  }

  .media-scroll.is-back-right {
    transform: none;
  }

  /* Keep the signature in normal flow beneath the biography on non-mobile layouts. */
  @media (min-width: 841px) {
    .about-copy > p:not(.about-role) {
      grid-column: 1 / -1;
    }

    .about-scrapbook {
      grid-column: 1 / -1;
      justify-self: end;
      width: 136px;
      margin: 18px 0 0;
      transform: none;
    }
  }

  @media (min-width: 841px) and (max-width: 1023px) {
    .about-wrap { padding-bottom: 10px; }
    .featured-wrap { padding-top: 10px; }
  }

  /* Desktop proportions: keep the display type, with a clearer size hierarchy. */
  @media (min-width: 1024px) {
    .hero-content h1:not(.hero-subtitle) {
      font-size: clamp(3.75rem, 5.3vw, 4.75rem);
      line-height: 1.12;
    }

    .hero-title-row {
      gap: 0.85rem;
    }

    .hero-content .hero-subtitle {
      font-size: clamp(1.6rem, 2.24vw, 2rem) !important;
      line-height: 1.15;
    }

    .about-wrap {
      padding-top: 44px;
      padding-bottom: 24px;
    }

    .about {
      grid-template-columns: 144px minmax(0, 1fr);
      gap: 1.75rem;
    }

    .avatar-stack,
    .avatar {
      width: 144px;
      height: 144px;
    }

    .about-role {
      font-size: clamp(1.5rem, 1.8vw, 1.8rem) !important;
      line-height: 1.15 !important;
    }

    .featured-wrap {
      padding-top: 20px;
    }

    .media-stack-head {
      margin-bottom: 1rem;
    }

    .media-scroll h3 {
      font-size: 3rem;
      line-height: 1.15;
      margin-bottom: 0.75rem;
    }
  }

  @media (max-width: 840px) {
    .hero-lately-wrap {
      width: min(280px, 48vw);
      right: clamp(20px, 5vw, 48px);
      top: 100%;
    }

    .media-pyramid {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .media-scroll-youtube {
      width: 100%;
    }

    .media-scroll h3 {
      font-size: 2.5rem;
    }

    .media-scroll-social iframe {
      height: 540px;
    }

    .media-scroll-tiktok iframe {
      width: min(100%, 304px);
      height: 540px;
    }

    .media-rotate-prev {
      left: -2.6rem;
    }

    .media-rotate-next {
      right: -2.6rem;
    }

    .media-scroll.is-back-left {
      transform: translate3d(-8%, 7%, 0) scale(0.85);
    }

    .media-scroll.is-back-right {
      transform: translate3d(8%, 7%, 0) scale(0.85);
    }
  }

  @media (max-width: 640px) {
    /* Keep the desktop staircase from pushing homepage sections off-screen. */
    :global(.page-home > .fadein) {
      margin-left: 0 !important;
    }

    /* Homepage-only mobile gutters; shared and desktop .wrap rules stay intact. */
    .wrap {
      width: auto;
      max-width: none;
      margin-left: 0;
      padding-left: 20px;
      padding-right: 20px;
    }

    .hero {
      min-height: 500px;
      height: 82svh;
      max-height: 760px;
    }

    .hero::before,
    .hero::after {
      background-color: rgba(0, 0, 0, 0.28);
      background-blend-mode: multiply;
    }

    .hero::after {
      background-position: 46% center;
    }

    .hero-content {
      justify-content: flex-end;
      padding-left: 20px;
      padding-right: 18px;
      padding-bottom: 52px;
    }

    .hero-title-row > h1:first-child {
      font-size: clamp(4.5rem, 22vw, 6.2rem) !important;
      line-height: 0.94;
    }

    .hero-content .hero-subtitle {
      margin-top: -0.75rem !important;
      font-size: clamp(1.25rem, 6vw, 1.7rem) !important;
      white-space: normal;
    }

    .hero-lately-wrap {
      width: min(270px, calc(100vw - 40px));
      right: 20px;
      top: 100%;
    }

    .hero-audio-card {
      min-height: 4.4rem;
      padding: 0.5rem 0.65rem;
    }

