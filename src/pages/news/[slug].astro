---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { posts } from "../../data/news";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout title={`JT | ${post.title}`} description={post.excerpt} mainClass="page-news-post">
  <article class="blog-post">
    <a class="back-link" href="/news">← All posts</a>
    <header>
      <time>{post.date}</time>
      <h1>{post.title}</h1>
      <p class="post-excerpt">{post.excerpt}</p>
    </header>
    <div class="post-body">
      {post.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </article>

  <style>
    .blog-post { width: min(100%, 760px); margin: 0 auto; padding: calc(var(--nav-h) + 24px) 24px 72px; }
    .back-link { display: inline-block; margin-bottom: 2rem; color: var(--tone-slate) !important; }
    time { color: var(--tone-plum); font-family: "JTDisplay", system-ui, sans-serif; }
    h1 { margin: .4rem 0 .8rem; font-size: clamp(3rem, 8vw, 6rem); text-align: left; }
    .post-excerpt { margin: 0; font-size: 1.25rem; line-height: 1.5; }
    .post-body { margin-top: 2.5rem; font-size: 1.15rem; }
    .post-body p { margin: 0 0 1.2rem; }
  </style>
</BaseLayout>
