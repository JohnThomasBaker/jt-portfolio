---
import BaseLayout from "../layouts/BaseLayout.astro";

const pieces = [
  { name: "Through the Glass", year: 2025, tag: "Composition", category: "compositions", image: "/images/hero2.jpg" },
  { name: "Still Circuit", year: 2024, tag: "Composition", category: "compositions", image: "/images/hero.jpg" },
  { name: "North Lot Reverie", year: 2024, tag: "Composition", category: "compositions", image: "/images/hero2.jpg" },
  { name: "Ash Line", year: 2023, tag: "Composition", category: "compositions", image: "/images/hero.jpg" },
  { name: "Brasslight", year: 2022, tag: "Composition", category: "compositions", image: "/images/hero2.jpg" },
  { name: "Quiet Cadence", year: 2021, tag: "Composition", category: "compositions", image: "/images/hero.jpg" },
];
---
<BaseLayout title="JT | Music" description="Works and recordings">
  <h1>Music</h1>
  <div class="music-tabs" role="tablist" aria-label="Music categories">
    <button class="music-tab is-active" type="button" role="tab" aria-selected="true" data-filter="all">All</button>
    <button class="music-tab" type="button" role="tab" aria-selected="false" data-filter="compositions">Compositions</button>
    <button class="music-tab" type="button" role="tab" aria-selected="false" data-filter="arrangements">Arrangements</button>
    <button class="music-tab" type="button" role="tab" aria-selected="false" data-filter="misc">Misc</button>
  </div>
  <div class="music-catalog">
    {pieces.map((piece) => (
      <article class="music-piece card" data-category={piece.category}>
        <img src={piece.image} alt={`${piece.name} score preview`} class="score-image" />
        <div class="piece-meta">
          <h3>{piece.name}</h3>
          <p class="piece-year">{piece.year}</p>
          <span class={`piece-tag ${piece.category === "arrangements" ? "is-arrangement" : "is-composition"}`}>
            {piece.tag}
          </span>
        </div>
      </article>
    ))}
  </div>

  <style>
    .music-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      width: fit-content;
      max-width: 100%;
      margin: 1.5rem 0 1.75rem;
      padding: 0.75rem;
      border: 1px solid rgba(63, 70, 94, 0.2);
      border-radius: 12px;
      background: rgba(233, 237, 248, 0.45);
    }

    .music-tab {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      min-height: 54px;
      padding: 0.75rem 1.25rem;
      border: 1px solid transparent;
      border-radius: 8px;
      background: transparent;
      color: #3f465e !important;
      font-family: "JTDisplay", system-ui, sans-serif;
      font-size: 1.4rem;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: 0.015em;
      cursor: pointer;
      transition: transform 180ms ease, background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
    }

    .music-tab:hover {
      background: rgba(63, 70, 94, 0.09);
      color: #20283c !important;
    }

    .music-tab.is-active {
      border-color: #3f465e;
      background: #3f465e;
      color: #c7951f !important;
      transform: translateY(-2px) scale(1.08);
      z-index: 1;
      box-shadow: 0 2px 5px rgba(31, 38, 56, 0.16);
    }

    .music-tab:focus-visible {
      outline: 2px solid #614445;
      outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
      .music-tab {
        transition: none;
      }
    }

    .music-catalog {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }

    .music-piece {
      padding: 0;
      overflow: hidden;
    }

    .score-image {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
      border-bottom: 1px solid rgba(0, 0, 0, 0.12);
      filter: saturate(0.55) contrast(1.05);
    }

    .piece-meta {
      padding: 1rem;
    }

    .piece-meta h3 {
      margin: 0;
      font-family: "JTDisplay", system-ui, sans-serif;
      font-size: 1.2rem;
      line-height: 1.2;
    }

    .piece-year {
      margin: 0.2rem 0 0.55rem;
      opacity: 0.8;
    }

    .piece-tag {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      font-size: 0.9rem;
      border: 1px solid rgba(0, 0, 0, 0.2);
      background: rgba(255, 255, 255, 0.6);
    }

    .piece-tag.is-composition {
      color: #3f4d67;
    }

    .piece-tag.is-arrangement {
      color: #614445;
    }

    @media (max-width: 960px) {
      .music-catalog {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .music-tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        width: 100%;
        box-sizing: border-box;
      }

      .music-tab {
        min-width: 0;
        padding: 0.75rem 0.5rem;
        font-size: 1.2rem;
      }

      .music-catalog {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script is:inline>
    const initMusicTabs = () => {
      const tabs = Array.from(document.querySelectorAll(".music-tab"));
      const cards = Array.from(document.querySelectorAll(".music-piece"));
      if (!tabs.length || !cards.length) return;

      const applyFilter = (filter) => {
        cards.forEach((card) => {
          const category = card.dataset.category || "";
          const show = filter === "all" || category === filter;
          card.style.display = show ? "" : "none";
        });

        tabs.forEach((tab) => {
          const active = tab.dataset.filter === filter;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => applyFilter(tab.dataset.filter || "all"));
      });
    };

    document.addEventListener("DOMContentLoaded", initMusicTabs);
    document.addEventListener("astro:page-load", initMusicTabs);
  </script>
</BaseLayout>
