---
import BaseLayout from "../layouts/BaseLayout.astro";
const posts = [
  { date: "September 15, 2026", category: "Studio Notes", title: "Blast", excerpt: "A few thoughts on what I am writing, listening to, and carrying into the next season.", body: "The studio is in motion. I am developing new percussion and chamber ideas while making room for the accidents and detours that make a piece feel alive." },
  { date: "August 28, 2026", category: "Field Notes", title: "Flat Circle Project", excerpt: "Why rehearsal rooms, marching fields, and quiet practice spaces all end up in the same work.", body: "The most useful ideas rarely arrive in isolation. They come from a phrase heard across a rehearsal room, a rhythm remembered from the field, or a texture found while practicing slowly." },
  { date: "July 12, 2026", category: "News", title: "Taksu Dua", excerpt: "New recordings, performances, and ways to spend time with the work are on the way.", body: "I am putting together new recordings and preparing several projects for release. This page will be the place for notes, dates, and occasional behind-the-scenes pieces." },
];
---
<BaseLayout title="JT | News" description="News and notes from JT" mainClass="page-news">
  <section class="news-hero" aria-labelledby="news-title">
    <img src="/images/Bass Drum Redbull.jpeg" alt="" class="news-hero-image" />
    <div class="news-hero-copy"><p class="news-kicker"></p><h1 id="news-title">News</h1><p class="news-hero-subtitle">Updates, field notes, and ongoing projects.</p></div>
  </section>
  <section class="news-content" aria-label="News posts"><header class="news-intro"><h2>Latest notes</h2><p>A running collection of announcements, process notes, and small discoveries.</p></header><div class="news-list">{posts.map((post, index) => <article class:list={["news-post", { "news-post-featured": index === 0 }]}><div class="news-post-meta"><time>{post.date}</time><span>{post.category}</span></div><div class="news-post-body"><h3>{post.title}</h3><p>{post.excerpt}</p><details><summary>Read note <span aria-hidden="true">→</span></summary><p>{post.body}</p></details></div></article>)}</div></section>
  <style>
    .news-hero{position:relative;isolation:isolate;display:grid;place-items:center;height:60vh;min-height:360px;padding:0 24px;overflow:hidden;background:#28303c}.news-hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.04);z-index:0}.news-hero:after{content:"";position:absolute;inset:0;z-index:1;background:rgba(0,0,0,.2);pointer-events:none}.news-hero-copy{position:relative;z-index:2;max-width:780px;text-align:center}.news-kicker{margin:0 0 18px;color:#e2d7bf!important;font:1.15rem "JTDisplay",serif;letter-spacing:.08em;text-transform:uppercase}.news-hero-copy h1{margin:0;color:#c7951f!important;font:400 clamp(5.4rem,14.4vw,10.8rem)/1 "Jacquard24",serif !important;text-shadow:0 4px 24px rgba(0,0,0,.9),0 2px 6px rgba(0,0,0,.8),0 1px 1px rgba(0,0,0,.7)}.news-hero-copy h1{font-size:clamp(3.75rem,5.3vw,4.75rem);line-height:1.12}.news-hero-subtitle{margin:24px 0 0;color:#f3ead8!important;font:1.35rem/1.35 "JTDisplay",serif}.news-content{width:min(100%,1040px);margin:0 auto;padding:56px 28px 80px}.news-intro{max-width:680px;margin-bottom:34px}.news-intro h2{margin:0 0 8px;font-size:clamp(2.4rem,5vw,4rem)}.news-intro p{margin:0;font-size:1.15rem}.news-list{display:grid;gap:18px}.news-post{display:grid;grid-template-columns:170px minmax(0,1fr);gap:28px;padding:26px 0;border-top:1px solid #3f465e47}.news-post:last-child{border-bottom:1px solid #3f465e47}.news-post-meta{display:grid;align-content:start;gap:7px;color:#66556f;font:1rem/1.25 "JTDisplay",serif}.news-post-meta span{color:#4f6a67;font-size:.9rem;text-transform:uppercase;letter-spacing:.06em}.news-post-body h3{margin:0 0 8px;color:#4b5b76;font-size:clamp(2rem,4vw,3.2rem);line-height:1.05}.news-post-body>p,.news-post details{max-width:680px}.news-post-body>p{margin:0 0 15px;font-size:1.12rem}.news-post summary{width:fit-content;cursor:pointer;color:#6b4d4b;font:1.1rem "JTDisplay",serif}.news-post summary span{display:inline-block;margin-left:7px}.news-post details p{margin:14px 0 0}@media(max-width:640px){.news-hero{min-height:360px;height:60vh;padding:56px 20px}.news-hero-copy h1{font-size:clamp(5.4rem,14.4vw,10.8rem)}.news-hero-subtitle{font-size:1.15rem}.news-content{padding:38px 20px 56px}.news-post{grid-template-columns:1fr;gap:10px;padding:22px 0}.news-post-meta{display:flex;flex-wrap:wrap;gap:8px 14px}}
  </style>
</BaseLayout>
