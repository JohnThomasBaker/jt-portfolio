---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="News Coming Soon | JT Baker" description="Articles and project updates from composer and percussionist JT Baker are coming soon." mainClass="page-news">
  <section class="news-hero" aria-labelledby="news-title">
    <img src="/images/news-hero.webp" width="1920" height="1434" alt="" class="news-hero-image" />
    <div class="news-hero-copy"><h1 id="news-title">News</h1><p class="news-hero-subtitle">Articles and project notes are on the way.</p></div>
  </section>
  <section class="news-content" aria-labelledby="coming-soon-title">
    <div class="news-coming-soon">
      <h2 id="coming-soon-title">Sign up for my email list</h2>
      <p>Get occasional updates about new projects, performances, composition, and percussion.</p>
      <form class="news-signup-form" name="email-list-signup" method="POST" action="https://formsubmit.co/johnthomasbaker19@gmail.com" data-newsletter-form>
        <input type="hidden" name="_subject" value="New email list signup" />
        <input type="hidden" name="_template" value="table" />
        <input class="news-honey" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input id="newsletter-email" type="email" name="email" autocomplete="email" placeholder="Your email address" required />
        <button type="submit">Sign up ↗</button>
        <p class="news-signup-status" data-newsletter-status aria-live="polite"></p>
      </form>
    </div>
  </section>
  <style>
    .news-hero{position:relative;isolation:isolate;display:grid;place-items:center;height:60vh;min-height:360px;padding:0 24px;overflow:hidden;background:#28303c}.news-hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.04);z-index:0}.news-hero:after{content:"";position:absolute;inset:0;z-index:1;background:rgba(0,0,0,.2);pointer-events:none}.news-hero-copy{position:absolute;left:24px;right:24px;bottom:10px;z-index:2;max-width:none;text-align:center}.news-hero-copy h1{margin:0;color:#c7951f!important;font:400 clamp(4.86rem,12.96vw,9.72rem)/1.12 "Jacquard24",serif !important;letter-spacing:.16245em;text-shadow:0 4px 24px rgba(0,0,0,.9),0 2px 6px rgba(0,0,0,.8),0 1px 1px rgba(0,0,0,.7)}.news-hero-subtitle{margin:8px 0 0;color:#f3ead8!important;font:1.35rem/1.35 "JTDisplay",serif}.news-content{width:min(100%,760px);margin:0 auto;padding:64px 28px 96px;text-align:center}.news-coming-soon{padding:clamp(2rem,6vw,4rem);border-top:1px solid rgba(63,70,94,.25);border-bottom:1px solid rgba(63,70,94,.25)}.news-kicker{margin:0 0 .75rem;color:var(--tone-plum)!important;font:1.05rem "JTDisplay",serif;letter-spacing:.12em;text-transform:uppercase}.news-coming-soon h2{margin:0 0 1rem;font-size:clamp(2.4rem,6vw,4.6rem);line-height:1}.news-coming-soon p:last-child{margin:0;font-size:1.15rem}@media(max-width:640px){.news-hero{min-height:500px;height:82svh;max-height:760px;padding:0 20px}.news-hero-copy{left:18px;right:18px;bottom:12px}.news-hero-copy h1{font-size:clamp(2.52rem,10.8vw,3.15rem)}.news-hero-subtitle{font-size:1.15rem}.news-content{padding:42px 20px 64px}}
    .news-signup-form{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;margin-top:1.35rem}.news-signup-form input[type="email"]{min-width:min(100%,280px);padding:.7rem .8rem;border:1px solid rgba(63,70,94,.35);background:rgba(255,255,255,.72);color:var(--text);font:1rem "GoudyBookletter1911",serif}.news-signup-form button{padding:.7rem 1rem;border:1px solid var(--tone-plum);background:var(--tone-plum);color:#fff;font:1rem "JTDisplay",serif;cursor:pointer}.news-signup-form button:hover{background:var(--tone-clay);border-color:var(--tone-clay)}.news-signup-status{flex-basis:100%;margin:0;font-size:.95rem;color:var(--tone-slate)!important}.news-honey{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0!important}.news-hero-copy h1{letter-spacing:normal}
  </style>
  <script is:inline>
    const initNewsletterForm = () => {
      const form = document.querySelector("[data-newsletter-form]");
      if (!form || form.dataset.newsletterFormInitialized === "true") return;
      form.dataset.newsletterFormInitialized = "true";
      const status = form.querySelector("[data-newsletter-status]");
      const button = form.querySelector('button[type="submit"]');

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const body = new URLSearchParams(new FormData(form)).toString();
        if (status) status.textContent = "Signing you up...";
        if (button) button.disabled = true;

        try {
          const response = await fetch("https://formsubmit.co/ajax/johnthomasbaker19@gmail.com", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded", Accept: "application/json" },
            body,
          });
          if (!response.ok) throw new Error("signup-failed");
          form.reset();
          if (status) status.textContent = "You’re on the list—thank you!";
        } catch (error) {
          console.error(error);
          if (status) status.textContent = "Could not sign you up right now. Please try again.";
        } finally {
          if (button) button.disabled = false;
        }
      });
    };

    document.addEventListener("DOMContentLoaded", initNewsletterForm);
    document.addEventListener("astro:page-load", initNewsletterForm);
  </script>
</BaseLayout>
