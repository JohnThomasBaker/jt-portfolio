---
import BaseLayout from "../layouts/BaseLayout.astro";
import { posts } from "../data/news";
---
<BaseLayout title="News | JT Baker" description="Project updates and studio notes from composer and percussionist JT Baker." mainClass="page-news">
  <section class="news-hero" aria-labelledby="news-title">
    <img src="/images/Bass Drum Redbull.jpeg" alt="" class="news-hero-image" />
    <div class="news-hero-copy"><p class="news-kicker"></p><h1 id="news-title">News</h1><p class="news-hero-subtitle">Updates and ongoing projects.</p></div>
  </section>
  <section class="news-content" aria-label="News posts"><header class="news-intro"><h2>Latest posts</h2><p>A running collection of announcements and updates.</p></header><div class="news-list">{posts.map((post, index) => <a class="news-post-link" href={`/news/${post.slug}`}><article class:list={["news-post", { "news-post-featured": index === 0 }]}><div class="news-post-meta"><time datetime={post.dateISO}>{post.date}</time></div><div class="news-post-body"><h3>{post.title}</h3><p>{post.excerpt}</p></div></article></a>)}</div></section>
  <style>
    .news-hero{position:relative;isolation:isolate;display:grid;place-items:center;height:60vh;min-height:360px;padding:0 24px;overflow:hidden;background:#28303c}.news-hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.04);z-index:0}.news-hero:after{content:"";position:absolute;inset:0;z-index:1;background:rgba(0,0,0,.2);pointer-events:none}.news-hero-copy{position:relative;z-index:2;max-width:780px;text-align:center}.news-kicker{margin:0 0 18px;color:#e2d7bf!important;font:1.15rem "JTDisplay",serif;letter-spacing:.08em;text-transform:uppercase}.news-hero-copy h1{margin:0;color:#c7951f!important;font:400 clamp(5.4rem,14.4vw,10.8rem)/1 "Jacquard24",serif !important;text-shadow:0 4px 24px rgba(0,0,0,.9),0 2px 6px rgba(0,0,0,.8),0 1px 1px rgba(0,0,0,.7)}.news-hero-copy h1{font-size:clamp(3.75rem,5.3vw,4.75rem);line-height:1.12}.news-hero-subtitle{margin:24px 0 0;color:#f3ead8!important;font:1.35rem/1.35 "JTDisplay",serif}.news-content{width:min(100%,1040px);margin:0 auto;padding:56px 28px 80px}.news-intro{max-width:680px;margin-bottom:34px}.news-intro h2{margin:0 0 8px;font-size:clamp(2.4rem,5vw,4rem)}.news-intro p{margin:0;font-size:1.15rem}.news-list{display:grid;gap:18px}.news-post-link{display:block;color:inherit;text-decoration:none}.news-post-link:hover h3{text-decoration:underline}.news-post{display:grid;grid-template-columns:170px minmax(0,1fr);gap:28px;padding:26px 0;border-top:1px solid #3f465e47}.news-post:last-child{border-bottom:1px solid #3f465e47}.news-post-meta{display:grid;align-content:start;color:#66556f;font:1rem/1.25 "JTDisplay",serif}.news-post-body h3{margin:0 0 8px;color:#4b5b76;font-size:clamp(2rem,4vw,3.2rem);line-height:1.05}.news-post-body>p{max-width:680px;margin:0;font-size:1.12rem}@media(max-width:640px){.news-hero{min-height:360px;height:60vh;padding:56px 20px}.news-hero-copy h1{font-size:clamp(5.4rem,14.4vw,10.8rem)}.news-hero-subtitle{font-size:1.15rem}.news-content{padding:38px 20px 56px}.news-post{grid-template-columns:1fr;gap:10px;padding:22px 0}}
  </style>
</BaseLayout>
