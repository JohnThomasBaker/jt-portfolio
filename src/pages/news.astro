---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="News Coming Soon | JT Baker" description="Articles and project updates from composer and percussionist JT Baker are coming soon." mainClass="page-news">
  <section class="news-hero" aria-labelledby="news-title">
    <img src="/images/news-hero.webp" width="1920" height="1434" alt="" class="news-hero-image" />
    <div class="news-hero-copy"><h1 id="news-title">News</h1><p class="news-hero-subtitle">Articles and project notes are on the way.</p></div>
  </section>
  <section class="news-content" aria-labelledby="coming-soon-title">
    <div class="news-coming-soon">
      <p class="news-kicker">Coming soon</p>
      <h2 id="coming-soon-title">Something worth reading.</h2>
      <p>I’m working on articles about current projects, performances, composition, and percussion. Check back soon.</p>
    </div>
  </section>
  <style>
    .news-hero{position:relative;isolation:isolate;display:grid;place-items:center;height:60vh;min-height:360px;padding:0 24px;overflow:hidden;background:#28303c}.news-hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.04);z-index:0}.news-hero:after{content:"";position:absolute;inset:0;z-index:1;background:rgba(0,0,0,.2);pointer-events:none}.news-hero-copy{position:relative;z-index:2;max-width:780px;text-align:center}.news-hero-copy h1{margin:0;color:#c7951f!important;font:400 clamp(3.75rem,5.3vw,4.75rem)/1.12 "Jacquard24",serif !important;text-shadow:0 4px 24px rgba(0,0,0,.9),0 2px 6px rgba(0,0,0,.8),0 1px 1px rgba(0,0,0,.7)}.news-hero-subtitle{margin:24px 0 0;color:#f3ead8!important;font:1.35rem/1.35 "JTDisplay",serif}.news-content{width:min(100%,760px);margin:0 auto;padding:64px 28px 96px;text-align:center}.news-coming-soon{padding:clamp(2rem,6vw,4rem);border-top:1px solid rgba(63,70,94,.25);border-bottom:1px solid rgba(63,70,94,.25)}.news-kicker{margin:0 0 .75rem;color:var(--tone-plum)!important;font:1.05rem "JTDisplay",serif;letter-spacing:.12em;text-transform:uppercase}.news-coming-soon h2{margin:0 0 1rem;font-size:clamp(2.4rem,6vw,4.6rem);line-height:1}.news-coming-soon p:last-child{margin:0;font-size:1.15rem}@media(max-width:640px){.news-hero{min-height:360px;height:60vh;padding:56px 20px}.news-hero-copy h1{font-size:clamp(5.4rem,14.4vw,10.8rem)}.news-hero-subtitle{font-size:1.15rem}.news-content{padding:42px 20px 64px}}
  </style>
</BaseLayout>
