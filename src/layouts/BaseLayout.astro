---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import signatureSvgSource from "../../public/images/JT_signature_1_vector_smooth.svg?raw";

type Props = {
  title?: string;
  description?: string;
  mainClass?: string;
  socialImage?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown>;
  preloadImages?: string[];
};

const {
  title = "JT Baker",
  description = "Music by composer and percussionist JT Baker.",
  mainClass = "page-default",
  socialImage = "/images/social-card.webp",
  ogType = "website",
  structuredData,
  preloadImages = [],
} = Astro.props as Props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const socialImageURL = Astro.site ? new URL(socialImage, Astro.site) : null;
const personStructuredData = Astro.site ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "JT Baker",
  url: Astro.site.href,
  image: socialImageURL?.href,
  email: "mailto:johnthomasbaker19@gmail.com",
  jobTitle: ["Composer", "Percussionist", "Teacher"],
}).replace(/</g, "\\u003c") : null;
const pageStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : null;
const currentYear = new Date().getFullYear();
const signatureSvgMarkup = signatureSvgSource
  .replace(/^<\?xml[^>]*>\s*/, "")
  .replaceAll('fill="#000000"', 'fill="currentColor"');

const nav = [
  { href: "/", label: "Home" },
  { href: "/music", label: "Music" },
  { href: "/lessons", label: "Lessons" },
  { href: "/news", label: "News" },
  { href: "/me", label: "Me" },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(`${href}/`) || pathname === href;
---
<!doctype html>
<html lang="en" class="js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="JT Baker" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    {socialImageURL && <meta property="og:image:width" content="1200" />}
    {socialImageURL && <meta property="og:image:height" content="630" />}
    {socialImageURL && <meta property="og:image:alt" content="JT Baker performing percussion" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    {personStructuredData && <script type="application/ld+json" set:html={personStructuredData} />}
    {pageStructuredData && <script type="application/ld+json" set:html={pageStructuredData} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/images/JT_signature_1_vector_smooth.svg" as="image" fetchpriority="high" />
    {preloadImages.map((href) => <link rel="preload" href={href} as="image" fetchpriority="high" />)}

    <style is:global>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        background: transparent;
        color: var(--text);
        font-family: "GoudyBookletter1911", serif;
        font-size: clamp(1.08rem, 0.35vw + 1rem, 1.2rem);
        line-height: 1.72;
        font-weight: 540;
        letter-spacing: 0.01em;
      }
      a { color: inherit; text-decoration: none; }
      a:hover { text-decoration: underline; }

      .wrap { max-width: 980px; /* left-align instead of center */ margin: 0 0 0 24px; padding: 24px; }
      main.wrap { padding-top: 0; }
main.wrap > :first-child { margin-top: 0 !important; }

    
      .brand { font-weight: 700; letter-spacing: 0.2px; }
      .links { display:flex; gap: 14px; flex-wrap: wrap; font-size: 1rem; color: rgba(255,255,255,0.85); }
      .links a { padding: 6px 8px; border-radius: 0; }
      .links a:hover { background: rgba(255,255,255,0.08); text-decoration: none; }

    
      h1 { margin: 0 0 10px; font-size: 34px; color: var(--tone-jacquard); }
      h2 { color: var(--tone-heading); }
      h3, .section-title { color: var(--tone-heading); }
      p, .muted, body *:not(h1):not(h2):not(h3):not(.section-title) {
        color: var(--text-muted) !important;
      }
      .section-title { color: var(--tone-moss) !important; } /* fallback */
      .st-green { color: var(--tone-moss) !important; }
      .st-red { color: var(--tone-clay) !important; }
      .st-navy { color: var(--tone-slate) !important; }
      .st-bronze { color: var(--tone-bronze) !important; }
      .st-plum { color: var(--tone-plum) !important; }
      .st-teal { color: var(--tone-teal) !important; }
      .card {
       padding: 0;
       border: none;
      background: none;
     }

      
      .muted { color: var(--text-muted); }

      .fadein {
        /* start opacity can be overridden; defaults to 0 unless a bg is set */
        opacity: var(--fade-start-opacity, 0);
        transform: translate3d(0, var(--fade-y, 12px), 0);
        filter: blur(var(--fade-blur, 0px));
        background-color: var(--fade-bg, var(--page-bg, transparent));
        transition:
          opacity var(--fade-dur, 900ms) cubic-bezier(.2,.8,.2,1),
          transform var(--fade-dur, 900ms) cubic-bezier(.2,.8,.2,1),
          filter var(--fade-blur-dur, var(--fade-dur, 900ms)) ease,
          background-color var(--fade-dur, 900ms) ease;
        will-change: opacity, transform, filter, background-color;
      }
      .fadein.is-in {
        opacity: 1;
        transform: translate3d(0, 0, 0);
        filter: blur(0);
        background-color: transparent;
      }
      @media (prefers-reduced-motion: reduce) {
        .fadein { opacity: 1; transform: none; transition: none; filter: none; background-color: none; }
      }

      :root {
        view-transition-name: none;
      }

      .page-shell {
        view-transition-name: page-content;
      }

      ::view-transition-old(page-content),
      ::view-transition-new(page-content) {
        animation-duration: 400ms;
        animation-timing-function: ease-in-out;
        animation-fill-mode: both;
        mix-blend-mode: normal;
      }

      ::view-transition-old(page-content) {
        animation-name: jt-page-fade-out;
      }

      ::view-transition-new(page-content) {
        animation-name: jt-page-fade-in;
      }

      @keyframes jt-page-fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      @keyframes jt-page-fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(page-content),
        ::view-transition-new(page-content) {
          animation-duration: 1ms;
        }

      }
    </style>

    <noscript>
      <style>
        .fadein { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    
  </head>
<script is:inline>
  const initFade = () => {
    const els = document.querySelectorAll(".fadein");
    if (!els.length) return;

    els.forEach((el) => {
      if (el.dataset.fadeInit === "1") return; // prevent double-init
      el.dataset.fadeInit = "1";

      const y = el.dataset.y || 0;
      const blur = el.dataset.blur || 0;
      const dur = el.dataset.dur || 900;
      const bg = el.dataset.bg || "";
      el.style.setProperty("--fade-y", y + "px");
      el.style.setProperty("--fade-blur", blur + "px");
      el.style.setProperty("--fade-dur", dur + "ms");
      // make blur finish a bit sooner than the rest
      el.style.setProperty("--fade-blur-dur", Math.max(dur * 0.8, 0) + "ms");
      if (bg) {
        el.style.setProperty("--fade-bg", bg);
        el.style.setProperty("--fade-start-opacity", 1);
      } else {
        el.style.setProperty("--fade-start-opacity", 0);
      }
    });

    const reveal = (el) => {
      const delay = parseInt(el.dataset.delay || 0, 10);
      setTimeout(() => el.classList.add("is-in"), delay);
    };

    if (!("IntersectionObserver" in window)) {
      els.forEach(reveal);
      return;
    }

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        reveal(e.target);
        if (e.target.dataset.once === "1") io.unobserve(e.target);
      }
    }, { threshold: 0.12 });

    els.forEach((el) => io.observe(el));
    els.forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) {
        reveal(el);
      }
    });
  };

  const initHeroScrollFade = () => {
    if (window.__heroScrollCleanup) window.__heroScrollCleanup();

    // Every image hero uses this shared overlap state for the nav signature.
    const hero = document.querySelector(".hero, .music-hero, .news-hero");
    if (!hero) {
      document.body.classList.remove("nav-over-hero");
      window.__heroScrollCleanup = null;
      return;
    }

    const FAST_FADE_MULTIPLIER = 0.16 * 1.3;
    const NORMAL_FADE_MULTIPLIER = 0.26 * 1.3;
    const FAST_UP_VELOCITY_THRESHOLD = -1.2; // px/ms

    let lastScrolled = 0;
    let lastTime = performance.now();

    const update = () => {
      const rect = hero.getBoundingClientRect();
      const scrolled = Math.max(0, -rect.top);
      const now = performance.now();
      const dt = Math.max(now - lastTime, 1);
      const velocity = (scrolled - lastScrolled) / dt;
      const isFastUpScroll = velocity < FAST_UP_VELOCITY_THRESHOLD;
      const fadeMultiplier = isFastUpScroll ? NORMAL_FADE_MULTIPLIER : FAST_FADE_MULTIPLIER;
      const fadeDistance = Math.max(hero.offsetHeight * fadeMultiplier, 1);
      const progress = Math.min(scrolled / fadeDistance, 1);
      const stepped = Math.round(progress * 22) / 22;
      hero.style.setProperty("--hero-progress", stepped.toFixed(4));
      document.body.classList.toggle("nav-over-hero", rect.top <= 18 && rect.bottom >= 131);
      lastScrolled = scrolled;
      lastTime = now;
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();

    window.__heroScrollCleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      document.body.classList.remove("nav-over-hero");
    };
  };

  const initSectionTitlePalette = () => {
    const targets = Array.from(document.querySelectorAll(".section-title, main.page-home h1:not(.hero-subtitle), main.page-music .music-piece h3"));
    if (!targets.length) return;

    const classes = ["st-green", "st-red", "st-navy", "st-bronze", "st-plum", "st-teal"];
    // Start offset changes each load, then cycle so adjacent titles are always different.
    const start = Math.floor(Math.random() * classes.length);

    let idx = 0;
    targets.forEach((el) => {
      if (classes.some((className) => el.classList.contains(className))) return;
      el.classList.remove(...classes);
      el.classList.add(classes[(start + idx) % classes.length]);
      idx += 1;
    });
  };

  const syncCurrentNav = () => {
    const pathname = window.location.pathname;
    document.querySelectorAll(".sidebar a").forEach((link) => {
      const href = link.getAttribute("href");
      const isCurrent = href === "/"
        ? pathname === "/"
        : Boolean(href && (pathname === href || pathname.startsWith(`${href}/`)));
      if (isCurrent) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  };

  const initNavToggle = () => {
    window.__navToggleCleanup?.();
    const button = document.querySelector(".logo");
    const links = document.querySelectorAll(".sidebar a");
    if (!button) return;

    const close = () => {
      document.body.classList.remove("nav-menu-open");
      button.setAttribute("aria-expanded", "false");
    };
    const toggle = () => {
      const isOpen = document.body.classList.toggle("nav-menu-open");
      button.setAttribute("aria-expanded", String(isOpen));
    };
    const onKeydown = (event) => {
      if (event.key !== "Escape") return;
      close();
      button.focus();
    };

    button.addEventListener("click", toggle);
    links.forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", onKeydown);
    window.__navToggleCleanup = () => {
      close();
      button.removeEventListener("click", toggle);
      links.forEach((link) => link.removeEventListener("click", close));
      document.removeEventListener("keydown", onKeydown);
    };
  };


  // First load
  document.addEventListener("DOMContentLoaded", () => {
    initFade();
    initHeroScrollFade();
    initSectionTitlePalette();
    syncCurrentNav();
    initNavToggle();
  });
  // The incoming page must be fully visible when the browser captures it for
  // the crossfade. Its scroll-reveal effects can initialize afterward.
  document.addEventListener("astro:before-swap", (event) => {
    event.newDocument.querySelectorAll(".fadein").forEach((el) => {
      el.classList.add("is-in");
    });
    const opensOnHero = Boolean(event.newDocument.querySelector(".hero, .music-hero, .news-hero"));
    event.newDocument.body.classList.toggle("nav-over-hero", opensOnHero);
    event.newDocument.body.classList.remove("nav-menu-open");
    if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
  });
  // Astro client-side navigations / view transitions
  document.addEventListener("astro:page-load", () => {
    initFade();
    initHeroScrollFade();
    initSectionTitlePalette();
    syncCurrentNav();
    initNavToggle();
  });
</script>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="nav">
      <div class="nav-inner">
        <div class="logo-sidebar">
          <button class="logo" type="button" aria-label="Open site navigation" aria-expanded="false">
            <span class="logo-mark" aria-hidden="true" set:html={signatureSvgMarkup}></span>
          </button>

          <nav class="sidebar" aria-label="Site navigation">
            {nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <div class="page-shell">
      <main id="main-content" class={mainClass}>
        <slot />
      </main>

      <footer class="site-footer wrap muted">
        <small>© {currentYear} JT Baker <span class="footer-signature" role="img" aria-label="JT signature"></span></small>
        <nav aria-label="Footer navigation">
          <a href="/music">Music</a>
          <a href="/lessons">Lessons</a>
          <a href="mailto:johnthomasbaker19@gmail.com">Contact</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
